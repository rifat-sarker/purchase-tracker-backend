generator client {
  provider      = "prisma-client-js"
  // "native" keeps local dev (macOS) working; rhel-openssl-3.0.x is what
  // Vercel's serverless Node runtime needs the query engine binary for.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Pooled connection (e.g. Neon/Supabase's PgBouncer URL) — required in
  // serverless since every function invocation can open a fresh
  // connection and a direct Postgres connection limit is exhausted fast.
  url       = env("DATABASE_URL")
  // Unpooled/direct connection, used only for migrations (`prisma migrate`
  // needs a session-mode connection, which a transaction-mode pooler
  // doesn't support). Same as DATABASE_URL for local dev / a plain VPS
  // Postgres with no pooler in front of it.
  directUrl = env("DIRECT_URL")
}

enum Category {
  PHONE
  LAPTOP
  DESKTOP
  MONITOR
  HUB
  CABLE
  PENDRIVE
  KEYBOARD
  MOUSE
  HEADPHONE
  CHARGER
  OTHER
}

enum ProductStatus {
  ACTIVE
  SOLD
  GIFTED
  BROKEN
  LOST
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Product {
  id               String        @id @default(cuid())
  name             String
  category         Category
  brand            String?
  model            String?

  // Flexible key-value specs — e.g. { "ram": "16GB", "storage": "512GB SSD" }
  specs            Json          @default("{}")

  // PUBLIC — copyright-free reference image (manufacturer press image / stock photo)
  referenceImage   String?

  // SENSITIVE — owner-only
  price            Float
  currency         String        @default("BDT")
  purchaseDate     DateTime
  purchasedFrom    String?
  warrantyExpiry   DateTime?
  serialNumber     String?
  receiptImages    String[]
  notes            String?

  status           ProductStatus @default(ACTIVE)
  tags             String[]
  warrantyNotified Boolean       @default(false)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([category])
  @@index([purchaseDate])
  @@index([warrantyExpiry])
  @@index([status])
}
